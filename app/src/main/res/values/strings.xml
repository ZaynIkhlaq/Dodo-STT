    <!-- Onboarding -->
    <string name="ob_welcome_body">A keyboard with no keys. Open it in any app, speak, and what you said is typed where your cursor is.</string>
    <string name="ob_start">Get started</string>
    <string name="ob_continue">Continue</string>

    <string name="ob_mic_title">Let Dodo hear you</string>
    <string name="ob_mic_body">Dodo records only while the panel says Listening. The clip is deleted from your phone the moment it comes back as text, and it is never sent anywhere but Groq.</string>
    <string name="ob_mic_action">Allow microphone</string>
    <string name="ob_mic_settings">Open app settings</string>
    <string name="ob_mic_granted">Microphone allowed</string>

    <string name="ob_kb_title">Turn Dodo on</string>
    <string name="ob_kb_body">Dodo lives in your keyboard list, beside Gboard. Android shows the same warning for every third-party keyboard — Dodo has no keys, so it never sees what you type on your normal one.</string>
    <string name="ob_kb_action">Open keyboard settings</string>
    <string name="ob_kb_enabled">Dodo is in your keyboard list</string>

    <string name="ob_key_title">Connect Groq</string>
    <string name="ob_key_body">Dodo transcribes with your own Groq key, so there is no account and no subscription. The free tier covers normal dictation.</string>
    <string name="ob_key_get">Get a free key</string>

    <string name="ob_done_title">You\'re set</string>
    <string name="ob_done_body">Tap any text field, then the keyboard-switch icon in the corner of your screen, and pick Dodo. Speak, tap the orb, and your words land in the field.</string>
    <string name="ob_done_action">Start using Dodo</string>
    <string name="ob_skip">Skip for now</string>

