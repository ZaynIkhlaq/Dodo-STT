<?xml version="1.0" encoding="utf-8"?>
<!-- Refined mono. Surfaces are paper and ink; the accent is rationed to the mic and the one
     primary action on a screen. If you find yourself reaching for accent a third time, don't. -->
<resources>
    <color name="bg">#FBFAF8</color>
    <color name="surface">#F2F0EC</color>
    <color name="hairline">#E7E4DE</color>

    <color name="text_primary">#111114</color>
    <color name="text_secondary">#6E6E78</color>
    <color name="text_tertiary">#9C9AA2</color>

    <color name="accent">#3D5AFE</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="rec">#E5484D</color>

    <color name="ok">#1C7D4D</color>
    <color name="warn">#B4531C</color>

    <!-- The sliding thumb of a segmented control: lifts off the track. -->
    <color name="thumb">#FFFFFF</color>
    <color name="switch_thumb_on">#3D5AFE</color>
    <color name="switch_thumb_off">#FFFFFF</color>
    <color name="switch_track_on">#663D5AFE</color>
    <color name="switch_track_off">#DAD6CE</color>

    <!-- Keyboard, after Samsung Keyboard's default light theme: white letter keys on a pale deck,
         modifiers a step greyer, no borders or shadows, and the toolbar the same tone as the deck.
         Samsung doesn't publish these; they are estimates to be tuned against the real thing. -->
    <color name="kb_bg">#F0F0F3</color>
    <color name="kb_key">#FFFFFF</color>
    <color name="kb_mod">#DCDCE1</color>
    <color name="kb_label">#1C1C1E</color>
    <color name="kb_hint">#8A8A8E</color>
    <!-- Laid over a key while it is held, then faded out. -->
    <color name="kb_press">#1F000000</color>
    <color name="kb_accent">#387AFF</color>
    <color name="kb_on_accent">#FFFFFF</color>
    <color name="kb_pill">#1C1C1E</color>
    <color name="kb_on_pill">#FFFFFF</color>
    <color name="kb_muted">#6E6E73</color>
    <color name="kb_bar">#F0F0F3</color>
    <color name="kb_cancel">#DCDCE1</color>
    <color name="kb_on_cancel">#1C1C1E</color>
</resources>
