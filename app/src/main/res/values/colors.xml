<?xml version="1.0" encoding="utf-8"?>
<!-- Refined mono. Surfaces are paper and ink; the accent is rationed to the mic and the one
     primary action on a screen. If you find yourself reaching for accent a third time, don't. -->
<resources>
    <color name="bg">#FBFAF8</color>
    <color name="surface">#F2F0EC</color>
    <color name="hairline">#E7E4DE</color>

    <color name="text_primary">#111114</color>
    <color name="text_secondary">#6E6E78</color>
    <color name="text_tertiary">#9C9AA2</color>

    <color name="accent">#3D5AFE</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="rec">#E5484D</color>

    <color name="ok">#1C7D4D</color>
    <color name="warn">#B4531C</color>

    <!-- The sliding thumb of a segmented control: lifts off the track. -->
    <color name="thumb">#FFFFFF</color>
    <color name="switch_thumb_on">#3D5AFE</color>
    <color name="switch_thumb_off">#FFFFFF</color>
    <color name="switch_track_on">#663D5AFE</color>
    <color name="switch_track_off">#DAD6CE</color>

    <!-- The docked tile: a neutral slab that sits back until it has something to say. -->
    <color name="tab_bg">#F4F4F6</color>
    <color name="tab_ink">#1C1C1E</color>
    <color name="tab_muted">#6E6E73</color>
    <color name="ok_soft">#1A1C7D4D</color>
</resources>
