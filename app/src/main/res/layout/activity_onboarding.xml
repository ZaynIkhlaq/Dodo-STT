<?xml version="1.0" encoding="utf-8"?>
<!--
  Five steps, one at a time, in a single Activity: only one child of the FrameLayout is visible and
  OnboardingActivity cross-fades between them. No ViewPager, and therefore no androidx.

  Every step is the same three things in the same places — a glyph in the tile the floating button
  uses, a line that says what this is, and a line that says why — so moving through setup feels like
  one screen changing rather than five screens arriving.
-->
<!-- The outer frame takes the system bar insets as its padding (fitsSystemWindows replaces a view's own
     padding), so the margins live one level in, where they survive. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View android:id="@+id/seg_0" style="@style/Dot" />
        <View android:id="@+id/seg_1" style="@style/Dot" />
        <View android:id="@+id/seg_2" style="@style/Dot" />
        <View android:id="@+id/seg_3" style="@style/Dot" />
        <View android:id="@+id/seg_4" style="@style/Dot" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/steps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 0 · Welcome -->
        <ScrollView
            android:id="@+id/step_welcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <!-- Centred when it fits, scrolls when it doesn't: small phones and large fonts. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:contentDescription="@string/cd_mark"
                    android:src="@drawable/ic_doodoo" />

                <TextView
                    style="@style/Display"
                    android:layout_marginTop="28dp"
                    android:text="@string/brand" />

                <TextView
                    style="@style/Body"
                    android:layout_marginTop="10dp"
                    android:text="@string/ob_welcome_body" />
            </LinearLayout>
        </ScrollView>

        <!-- 1 · Microphone -->
        <ScrollView
            android:id="@+id/step_mic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <!-- Centred when it fits, scrolls when it doesn't: small phones and large fonts. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView
                    style="@style/GlyphTile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mic" />

                <TextView style="@style/Title" android:layout_marginTop="24dp" android:text="@string/ob_mic_title" />
                <TextView style="@style/Body" android:layout_marginTop="10dp" android:text="@string/ob_mic_body" />

                <LinearLayout
                    android:id="@+id/mic_ok"
                    style="@style/Chip"
                    android:layout_marginTop="22dp"
                    android:visibility="invisible">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        android:tint="@color/ok" />

                    <TextView
                        style="@style/RowState"
                        android:layout_marginStart="8dp"
                        android:text="@string/ob_mic_granted"
                        android:textColor="@color/ok" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 2 · The button: two switches, one step -->
        <ScrollView
            android:id="@+id/step_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <!-- Centred when it fits, scrolls when it doesn't: small phones and large fonts. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView
                    style="@style/GlyphTile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield" />

                <TextView style="@style/Title" android:layout_marginTop="24dp" android:text="@string/ob_bar_title" />
                <TextView style="@style/Body" android:layout_marginTop="10dp" android:text="@string/ob_bar_body" />

                <LinearLayout
                    android:id="@+id/bar_ok"
                    style="@style/Chip"
                    android:layout_marginTop="20dp"
                    android:visibility="invisible">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        android:tint="@color/ok" />

                    <TextView
                        style="@style/RowState"
                        android:layout_marginStart="8dp"
                        android:text="@string/ob_bar_enabled"
                        android:textColor="@color/ok" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/record_ok"
                    style="@style/Chip"
                    android:layout_marginTop="8dp"
                    android:visibility="invisible">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        android:tint="@color/ok" />

                    <TextView
                        style="@style/RowState"
                        android:layout_marginStart="8dp"
                        android:text="@string/ob_record_allowed"
                        android:textColor="@color/ok" />
                </LinearLayout>

                <TextView
                    style="@style/Hint"
                    android:layout_marginTop="18dp"
                    android:text="@string/ob_bar_path" />
            </LinearLayout>
        </ScrollView>

        <!-- 3 · Groq key -->
        <ScrollView
            android:id="@+id/step_key"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <!-- Centred when it fits, scrolls when it doesn't: small phones and large fonts. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView
                    style="@style/GlyphTile"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_key" />

                <TextView style="@style/Title" android:layout_marginTop="24dp" android:text="@string/ob_key_title" />
                <TextView style="@style/Body" android:layout_marginTop="10dp" android:text="@string/ob_key_body" />

                <EditText
                    android:id="@+id/key"
                    style="@style/Field"
                    android:layout_marginTop="20dp"
                    android:hint="@string/key_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPassword|textNoSuggestions"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/key_state"
                        style="@style/RowState"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_tertiary" />

                    <Button
                        android:id="@+id/key_test"
                        style="@style/TextButton"
                        android:text="@string/key_test" />
                </LinearLayout>

                <Button
                    android:id="@+id/key_get"
                    style="@style/TextButton"
                    android:layout_marginStart="-10dp"
                    android:layout_marginTop="6dp"
                    android:drawableEnd="@drawable/ic_external"
                    android:drawablePadding="7dp"
                    android:text="@string/ob_key_get" />
            </LinearLayout>
        </ScrollView>

        <!-- 4 · The gestures, then try them -->
        <ScrollView
            android:id="@+id/step_done"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <!-- Centred when it fits, scrolls when it doesn't: small phones and large fonts. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView style="@style/Title" android:text="@string/ob_done_title" />

                <LinearLayout style="@style/Card" android:layout_marginTop="20dp" android:paddingEnd="18dp">

                    <LinearLayout style="@style/Row" android:background="@null">
                        <TextView style="@style/RowTitle" android:text="@string/gesture_hold_key" />
                        <TextView
                            style="@style/RowState"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/gesture_hold" />
                    </LinearLayout>

                    <View style="@style/Hairline" />

                    <LinearLayout style="@style/Row" android:background="@null">
                        <TextView style="@style/RowTitle" android:text="@string/gesture_double_key" />
                        <TextView
                            style="@style/RowState"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/gesture_double" />
                    </LinearLayout>

                    <View style="@style/Hairline" />

                    <LinearLayout style="@style/Row" android:background="@null">
                        <TextView style="@style/RowTitle" android:text="@string/gesture_drag_key" />
                        <TextView
                            style="@style/RowState"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/gesture_drag" />
                    </LinearLayout>
                </LinearLayout>

                <EditText
                    android:id="@+id/try_field"
                    style="@style/Field"
                    android:layout_marginTop="22dp"
                    android:gravity="top"
                    android:hint="@string/try_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <Button
        android:id="@+id/action_primary"
        style="@style/PrimaryButton"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/action_secondary"
        style="@style/TextButton"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="@string/ob_skip"
        android:textColor="@color/text_secondary" />
</LinearLayout>
</FrameLayout>
