<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole product, in one bar: a menu, a status line that speaks only when it has something to
  say, discard while recording, and the pill. It floats above your own keyboard rather than
  replacing it, so it stays small and never covers more than a row of keys.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_float"
    android:elevation="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <ImageButton
        android:id="@+id/btn_menu"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_panel_key"
        android:contentDescription="@string/cd_menu"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_dodo"
        android:tint="@color/bar_muted" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxWidth="150dp"
        android:maxLines="2"
        android:textColor="@color/bar_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btn_cancel"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_cancel"
        android:contentDescription="@string/cd_cancel"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        android:tint="@color/bar_on_cancel"
        android:visibility="gone" />

    <com.zaynikhlaq.dodostt.StartPillView
        android:id="@+id/pill"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/cd_mic" />
</LinearLayout>
