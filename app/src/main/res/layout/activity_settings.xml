<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings, rebuilt as hairline-separated rows rather than filled cards. The "Needs attention"
  block at the top is hidden outright once the microphone and the keyboard list are both sorted,
  so a working install opens on its actual settings instead of on finished chores.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="28dp"
        android:paddingEnd="26dp"
        android:paddingBottom="48dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/cd_mark"
            android:src="@drawable/ic_dodo"
            android:tint="@color/text_primary" />

        <TextView
            style="@style/Display"
            android:layout_marginTop="14dp"
            android:text="@string/brand" />

        <TextView
            style="@style/Body"
            android:layout_marginTop="2dp"
            android:text="@string/tagline" />

        <!-- Setup — hidden once nothing here needs doing -->
        <TextView
            android:id="@+id/setup_label"
            style="@style/SectionLabel"
            android:text="@string/section_setup" />

        <LinearLayout
            android:id="@+id/setup_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout android:id="@+id/mic_row" style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/step_mic" />
                    <TextView android:id="@+id/mic_state" style="@style/RowState" android:layout_marginTop="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/mic_action"
                    style="@style/TextButton"
                    android:text="@string/step_mic_action" />
            </LinearLayout>

            <View android:id="@+id/setup_divider" style="@style/Hairline" />

            <LinearLayout android:id="@+id/ime_row" style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/step_enable" />
                    <TextView android:id="@+id/ime_state" style="@style/RowState" android:layout_marginTop="2dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/ime_action"
                    style="@style/TextButton"
                    android:text="@string/step_enable_action" />
            </LinearLayout>
        </LinearLayout>

        <!-- Key -->
        <TextView style="@style/SectionLabel" android:text="@string/section_key" />

        <EditText
            android:id="@+id/key"
            style="@style/Field"
            android:hint="@string/key_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword|textNoSuggestions"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/key_state"
                style="@style/RowState"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/key_saved"
                android:textColor="@color/text_tertiary" />

            <Button
                android:id="@+id/key_test"
                style="@style/TextButton"
                android:text="@string/key_test" />
        </LinearLayout>

        <!-- Model -->
        <TextView style="@style/SectionLabel" android:text="@string/section_model" />

        <com.zaynikhlaq.dodostt.SegmentedControl
            android:id="@+id/model_segments"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView style="@style/Hint" android:text="@string/model_hint" />

        <!-- Language -->
        <TextView style="@style/SectionLabel" android:text="@string/section_language" />

        <com.zaynikhlaq.dodostt.SegmentedControl
            android:id="@+id/language_segments"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView style="@style/Hint" android:text="@string/language_hint" />

        <!-- Behaviour -->
        <TextView style="@style/SectionLabel" android:text="@string/section_behaviour" />

        <LinearLayout android:id="@+id/autostart_row" style="@style/Row">
            <TextView
                style="@style/RowTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingEnd="8dp"
                android:text="@string/opt_autostart" />

            <Switch android:id="@+id/opt_autostart" style="@style/Toggle" />
        </LinearLayout>

        <View style="@style/Hairline" />

        <LinearLayout android:id="@+id/autoreturn_row" style="@style/Row">
            <TextView
                style="@style/RowTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingEnd="8dp"
                android:text="@string/opt_autoreturn" />

            <Switch android:id="@+id/opt_autoreturn" style="@style/Toggle" />
        </LinearLayout>

        <!-- Updates -->
        <TextView style="@style/SectionLabel" android:text="@string/section_updates" />

        <LinearLayout style="@style/Row">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/update_title" style="@style/RowTitle" />
                <TextView android:id="@+id/update_state" style="@style/RowState" android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/update_action"
                style="@style/TextButton" />
        </LinearLayout>

        <!-- Try -->
        <TextView style="@style/SectionLabel" android:text="@string/section_try" />

        <EditText
            android:id="@+id/try_field"
            style="@style/Field"
            android:gravity="top"
            android:hint="@string/try_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />

        <Button
            android:id="@+id/switch_keyboard"
            style="@style/TextButton"
            android:layout_marginStart="-10dp"
            android:layout_marginTop="4dp"
            android:text="@string/switch_keyboard" />
    </LinearLayout>
</ScrollView>
