<?xml version="1.0" encoding="utf-8"?>
<!--
  The button, and a label that only appears when there is something to say: the clock while
  recording, or a word of help after a tap that did nothing. The label sits on whichever side the
  button isn't, so it never runs off the screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hint"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:textColor="@color/orb_ink"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.zaynikhlaq.dodostt.OrbView
        android:id="@+id/orb"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/cd_mic" />
</LinearLayout>
