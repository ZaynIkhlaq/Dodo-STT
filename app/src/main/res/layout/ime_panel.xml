<?xml version="1.0" encoding="utf-8"?>
<!--
  Two faces of the same panel, stacked so they are always the same height and nothing jumps.

  Typing: a bar of ours over a keyboard that is otherwise the platform's.
  Listening: the keyboard is taken over entirely — discard, a level meter, one word, insert. The
  typing face stays INVISIBLE rather than GONE, which is what holds the height steady.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg">

    <LinearLayout
        android:id="@+id/typing_face"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@color/kb_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_panel_key"
                android:contentDescription="@string/cd_menu"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                android:tint="@color/kb_label" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:textColor="@color/kb_muted"
                android:textSize="13sp" />

            <com.zaynikhlaq.dodostt.StartPillView
                android:id="@+id/pill"
                android:layout_width="106dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_mic" />
        </LinearLayout>

        <com.zaynikhlaq.dodostt.KeyboardView
            android:id="@+id/keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/listening_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_cancel"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="top|start"
            android:layout_margin="14dp"
            android:background="@drawable/bg_cancel"
            android:contentDescription="@string/cd_cancel"
            android:padding="13dp"
            android:src="@drawable/ic_close"
            android:tint="@color/kb_on_cancel" />

        <ImageButton
            android:id="@+id/btn_done"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="top|end"
            android:layout_margin="14dp"
            android:background="@drawable/bg_confirm"
            android:contentDescription="@string/cd_done"
            android:padding="13dp"
            android:src="@drawable/ic_check"
            android:tint="@color/kb_on_confirm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.zaynikhlaq.dodostt.WaveformView
                android:id="@+id/wave"
                android:layout_width="wrap_content"
                android:layout_height="56dp" />

            <TextView
                android:id="@+id/listening_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="@string/listening"
                android:textColor="@color/kb_label"
                android:textSize="22sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
