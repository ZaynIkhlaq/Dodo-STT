<?xml version="1.0" encoding="utf-8"?>
<!--
  A toolbar over a keyboard, and nothing else. Voice lives in the toolbar: starting a dictation
  swaps the menu for discard and puts the elapsed time beside the pill, while the keys stay exactly
  where they were — so a typo mid-sentence is one tap away, not a mode switch.

  The overlay on top draws key previews and the long-press popup, which rise above the top row into
  the toolbar. It never takes a touch.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/kb_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageButton
                    android:id="@+id/btn_menu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_panel_key"
                    android:contentDescription="@string/cd_menu"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_menu"
                    android:tint="@color/kb_muted" />

                <ImageButton
                    android:id="@+id/btn_cancel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_cancel"
                    android:contentDescription="@string/cd_cancel"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:tint="@color/kb_on_cancel"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:textColor="@color/kb_muted"
                android:textSize="13sp" />

            <com.zaynikhlaq.dodostt.StartPillView
                android:id="@+id/pill"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cd_mic" />
        </LinearLayout>

        <com.zaynikhlaq.dodostt.KeyboardView
            android:id="@+id/keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <com.zaynikhlaq.dodostt.KeyOverlayView
        android:id="@+id/key_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
