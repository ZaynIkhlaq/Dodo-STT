<?xml version="1.0" encoding="utf-8"?>
<!--
  A voice bar over a keyboard. The orb keeps all three of its states at 56 dp; the keys below mean
  a typo no longer costs a trip through the keyboard switcher.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <com.zaynikhlaq.dodostt.MicButtonView
            android:id="@+id/mic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_mic" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:letterSpacing="-0.01"
            android:maxLines="2"
            android:text="@string/status_idle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_cancel"
            style="@style/PanelKey"
            android:contentDescription="@string/cd_cancel"
            android:src="@drawable/ic_close"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/btn_keyboard"
            style="@style/PanelKey"
            android:contentDescription="@string/cd_keyboard"
            android:src="@drawable/ic_keyboard" />
    </LinearLayout>

    <View
        style="@style/Hairline"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp" />

    <com.zaynikhlaq.dodostt.KeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp" />
</LinearLayout>
